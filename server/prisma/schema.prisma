datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          String   @id
  name        String
  description String
  color       String
  isSystem    Boolean  @default(false)
  permissions String   // JSON array string of permission strings, e.g. '["salle.view", ...]'
  staff       Staff[]
}

model Staff {
  id        String   @id
  name      String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  pin       String   // PIN code (4 digits, e.g. "1011")
  email     String?
  phone     String?
  active    Boolean  @default(true)
  avatarBg  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Table {
  id                String        @id
  number            Int           @unique
  seats             Int
  x                 Float
  y                 Float
  reserved          Boolean       @default(false)
  alert             Boolean       @default(false)
  reservationName   String?
  reservationPeople Int?
  reservationTime   String?
  reservationNote   String?
  orders            Order[]
  reservations      Reservation[]
}

model Category {
  id      String @id
  name    String
  accent  String
  vatRate Float  @default(10)
  station String @default("kitchen") // "kitchen" | "bar"
}

model Product {
  id             String       @id
  name           String
  cat            String
  price          Float
  happyHourPrice Float?      // Tarif Happy Hour optionnel
  desc           String
  emoji          String?      @default("🍽️")
  allergens      String       // JSON array string of allergen tags, e.g. '["Gluten", "Lactose"]'
  available      Boolean      @default(true)
  isMenu         Boolean      @default(false)
  vatRate        Float        @default(10)
  station        String       @default("kitchen") // "kitchen" | "bar"
  options        String       @default("[]") // JSON : [{ name, required, max, choices: [{ label, price }] }] (cuisson, suppléments...)
  hours          String?      // Créneaux de vente, ex. "11:30-14:30, 19:00-22:30" (null : toute la journée)
  recipeItems    RecipeItem[]
}

model Ingredient {
  id           String          @id
  name         String
  category     String          // "Boucherie", "Maraîchage", "Épicerie", "Crémerie", "Boissons", "Pains"
  unit         String          // "g", "kg", "ml", "cl", "l", "piece"
  currentStock Float           @default(0)
  minThreshold Float           @default(5)
  idealStock   Float           @default(20)
  costPerUnit  Float           @default(0)   // Prix unitaire d'achat HT
  supplier     String?         // Nom fournisseur principal
  supplierRef  String?         // Référence fournisseur
  archived     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  recipeItems  RecipeItem[]
  movements    StockMovement[]
}

model RecipeItem {
  id           String     @id
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity     Float      // Dosage par portion
  unit         String     // Unité de dosage
  isCritical   Boolean    @default(true) // Si épuisé -> bloque le produit
  notes        String?

  @@unique([productId, ingredientId])
}

model StockMovement {
  id           String      @id
  ingredientId String
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  type         String      // "ORDER_CONSUMPTION" | "DELIVERY" | "WASTE" | "ADJUSTMENT" | "CANCEL_RETURN"
  quantity     Float       // + pour entrée, - pour consommation / perte
  unitCost     Float?      // Coût d'achat unitaire
  orderId      String?     // Réf commande liée
  staffId      String?     // Auteur
  reason       String?     // Motif en cas de perte / ajustement
  createdAt    DateTime    @default(now())
}

model Menu {
  id        String  @id
  name      String
  price     Float
  desc      String
  emoji     String? @default("📋")
  available Boolean @default(true)
  groups    String  // JSON string containing menu step choices and options
  hours     String? // Créneaux de vente, ex. "11:30-14:30" (null : toute la journée)
}

model Order {
  id        String      @id
  tableId   String?     // Absent hors salle (emporter, livraison)
  table     Table?      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  serverId  String?
  serverRef Staff?      @relation(fields: [serverId], references: [id])
  server    String      // Cached server display name (e.g. "Léa")
  status    String      @default("open") // "open" | "closed" | "cancelled" (hors salle créée par erreur)
  createdAt DateTime    @default(now())
  sentAt    DateTime?
  discount  String?     // JSON string { type: "percent"|"fixed", value: number, reason?: string, code?: string, amount: number }
  // Mode de service : "dine_in" | "takeaway" | "delivery" (livraison : module futur)
  type          String    @default("dine_in")
  // Canal de prise de commande : "pos" (caisse) | "phone" | "online" | plateformes ("ubereats", "deliveroo"…)
  channel       String    @default("pos")
  customerName  String?
  customerPhone String?
  pickupAt      DateTime? // Heure de retrait / livraison souhaitée
  pickupNumber  Int?      // Numéro d'appel du jour, attribué par le serveur
  covers        Int?      // Couverts saisis à l'ouverture de la table (null : non renseigné)
  billRequestedAt DateTime? // Addition demandée par la table (null : pas de demande)
  paidTotal     Float     @default(0) // Déjà encaissé par des tickets partiels (un ticket par convive)
  externalRef   String?   // Identifiant de la commande chez le canal externe (plateforme, site)
  items     OrderItem[]

  @@unique([channel, externalRef]) // Une commande externe n'est importée qu'une fois
}

model OrderItem {
  id          String   @id
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  name        String
  price       Float
  qty         Int      @default(1)
  notes       String?  @default("")
  status      String   @default("draft") // "draft" | "new" | "preparing" | "ready" | "served"
  isMenu      Boolean  @default(false)
  composition String?  // JSON string of selected items if composed menu
  course      String   @default("direct") // "direct" | "entree" | "plat" | "dessert" | "boisson"
  courseStatus String  @default("direct") // "direct" | "held" | "called"
  station     String   @default("kitchen") // "kitchen" | "bar"
  vatRate     Float    @default(10) // Taux figé à l'ajout, copié du produit (NF525 : ventilation TVA)
  paidQty     Int      @default(0) // Quantité déjà encaissée sur un ticket partiel (partage par convive)
  vatSplit    String?  // Menu à plusieurs taux : JSON [{ rate, weight }], poids = prix des composants en centimes
  options     String?  // Libellé figé des options choisies, ex. "Saignant · Bacon (+2.00€)" (supplément inclus dans price)
}

model Reservation {
  id           String   @id
  customerName String
  phone        String
  email        String?
  date         String   // YYYY-MM-DD
  time         String   // HH:mm
  guests       Int      @default(2)
  status       String   @default("confirmed") // "confirmed" | "seated" | "cancelled" | "no_show"
  tableId      String?
  table        Table?   @relation(fields: [tableId], references: [id])
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderHistory {
  id             String   @id
  orderId        String   @unique // Une commande ne peut être encaissée qu'une fois
  ticketNumber   String?  @unique // e.g. "FAC-2026-0001", attribué par le serveur
  tableNumber    Int?
  orderType      String   @default("dine_in") // Mode de service de la commande (ventilation sur place / emporter)
  channel        String   @default("pos")
  orderLabel     String?  // Libellé hors salle figé, ex. "Emporter #12 · Dupont"
  server         String
  items          String   // JSON snapshot of paid items
  total          Float
  subtotal       Float?   // Total before discount
  discount       String?  // JSON snapshot { type, value, reason, code, amount }
  vatDetails     String?  // JSON snapshot of VAT breakdown [{ rate, ht, vat, ttc }]
  paymentMethod  String
  payments       String   // JSON snapshot of payment breakdowns
  sequenceNumber Int?     @unique // Numéro séquentiel strict de transaction (NF525)
  previousHash   String?  // Hash du ticket précédent (chaînage)
  signature      String?  // Hash SHA-256 de ce ticket
  closedInZId    String?  // Référence au rapport Z dans lequel ce ticket a été clôturé
  tip            Float?   @default(0) // Pourboire perçu (hors CA soumis à TVA)
  covers         Int?     // Couverts de la commande (statistiques du Z, ticket moyen par couvert)
  type           String   @default("SALE") // "SALE" | "CREDIT_NOTE" (avoir, montants négatifs)
  refTicketNumber String? // Ticket d'origine annulé par cet avoir
  reason         String?  // Motif obligatoire d'un avoir
  createdAt      DateTime @default(now())
}

// Journal des événements techniques (JET, NF525) : append-only, chaîné et signé
model EventLog {
  id             String   @id
  sequenceNumber Int      @unique
  type           String   // ex: "AUTH_OK", "AUTH_FAIL", "Z_CLOSING", "CREDIT_NOTE", "CONFIG_UPDATE"
  staffId        String?
  staffName      String?
  details        String   // JSON
  previousHash   String
  signature      String
  createdAt      DateTime @default(now())
}

model DailyClosing {
  id                String   @id // ex: "z_1720000000_abcd"
  sequenceNumber    Int      @unique // Numéro séquentiel strict Z (1, 2, 3...)
  reportNumber      String   @unique // ex: "Z-2026-0001"
  openedAt          DateTime
  closedAt          DateTime @default(now())
  closedBy          String   // Nom du collaborateur
  totalGross        Float    // CA brut TTC
  totalDiscounts    Float    // Total remises
  totalNet          Float    // CA net TTC
  totalHT           Float    // CA net HT
  totalVAT          Float    // Total TVA collectée
  totalTips         Float?   @default(0) // Total pourboires collectés
  ticketsCount      Int      // Nombre total de tickets
  coversCount       Int      // Nombre total de personnes/couverts
  paymentsBreakdown String   // JSON snapshot: { carte: 150.0, especes: 80.0, ... }
  vatBreakdown      String   // JSON snapshot: [{ rate: 10, ht: ..., vat: ..., ttc: ... }, ...]
  openingCash       Float    @default(0) // Fond de caisse initial
  countedCash       Float?   // Espèces physiques comptées
  cashVariance      Float?   // Écart de caisse (countedCash - theoreticalCash)
  grandTotalBefore  Float    // Grand Total cumulé avant ce Z
  grandTotal        Float    // Grand Total perpétuel cumulé après ce Z (NF525)
  previousHash      String?  // Hash du Z précédent (chaînage)
  signature         String   // Signature numérique de scellement
  orderHistoryIds   String   // JSON array des IDs de tickets rattachés
  createdAt         DateTime @default(now())
}

// Clôtures mensuelles et annuelles (NF525) : cumul des Z de la période, en ajout seul, chaînées et signées
model PeriodClosing {
  id                String   @id
  type              String   // "MONTH" | "YEAR"
  period            String   // "2026-10" (mois) ou "2026" (année)
  sequenceNumber    Int      @unique // Numéro séquentiel strict, toutes périodes confondues
  reportNumber      String   @unique // "M-2026-10" ou "A-2026"
  periodStart       DateTime
  periodEnd         DateTime // exclu
  closedAt          DateTime @default(now())
  closedBy          String
  closingsCount     Int      // Nombre de Z (mois) ou de clôtures mensuelles (année) cumulés
  firstReport       String?  // Premier Z / mois inclus
  lastReport        String?  // Dernier Z / mois inclus
  totalGross        Float
  totalDiscounts    Float
  totalNet          Float
  totalHT           Float
  totalVAT          Float
  totalTips         Float
  ticketsCount      Int
  coversCount       Int
  paymentsBreakdown String   // JSON { carte, especes, ... }
  vatBreakdown      String   // JSON [{ rate, ht, vat, ttc }]
  grandTotal        Float    // Grand Total perpétuel à la fin de la période
  previousHash      String?
  signature         String

  @@unique([type, period])
}

model RestaurantConfig {
  id               String    @id @default("default")
  name             String    @default("RestoFlow Bistrot")
  legalName        String    @default("RESTOFLOW SAS")
  siret            String    @default("987 654 321 00012")
  vatNumber        String    @default("FR 12 987654321")
  address          String    @default("14 Rue de la Paix")
  city             String    @default("75002 Paris")
  phone            String    @default("01 42 68 55 00")
  email            String    @default("contact@restoflow-bistrot.fr")
  website          String    @default("www.restoflow.fr")
  footerNote       String    @default("Merci de votre visite ! Service et taxes compris.")
  currency         String    @default("EUR")
  tpeAutoPrint     Boolean   @default(true)
  printers         String    @default("[]") // JSON string of printer configs
  promoCodes       String    @default("[]") // JSON string of promo codes
  happyHourConfig  String?   @default("{\"enabled\":false,\"startTime\":\"17:00\",\"endTime\":\"20:00\",\"days\":[1,2,3,4,5],\"discountPercent\":20,\"categories\":[\"boissons\"]}")
  modulesConfig    String?   @default("{\"enableStockManagement\":true,\"enableOnlineReservations\":true,\"enableCoursePacing\":true,\"enableMultiStationKds\":true,\"enableDiscounts\":true,\"enableAdvancedSplitModes\":true,\"enablePinAuth\":true,\"enableTips\":true}")
  fecExportConfig  String?   @default("{\"journalCode\":\"VT\",\"accountVente10\":\"706000\",\"accountVente20\":\"707000\",\"accountVat10\":\"445710\",\"accountVat20\":\"445720\",\"accountCard\":\"512000\",\"accountCash\":\"530000\",\"accountOther\":\"580000\"}")
  grandTotal       Float     @default(0) // Grand Total perpétuel cumulé
  lastClosingDate  DateTime?
  nf525Key         String?   // Clé de scellement NF525 aléatoire, générée à la création (jamais de valeur par défaut)
  updatedAt        DateTime  @updatedAt
}

// Actions client déjà traitées (idempotence des rejeux hors-ligne et des ré-émissions après timeout)
model ProcessedAction {
  id        String   @id // clientActionId généré par le terminal
  handler   String
  createdAt DateTime @default(now())
}
