# Secret de signature des sessions (obligatoire en production, ex : openssl rand -hex 32)
JWT_SECRET=
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173
PORT=3000
# Base SQLite (chemin relatif à prisma/schema.prisma, ou absolu : file:/var/lib/restoflow/restoflow.db)
DATABASE_URL=file:./dev.db
# Dossier des sauvegardes (idéalement une clé USB ou un dossier synchronisé dans le cloud)
BACKUP_DIR=./backups
